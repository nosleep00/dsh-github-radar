{
  "name": "dsh-github-radar",
  "version": "0.1.0",
  "description": "GitHub 雷达 — 读取当前会话上下文，在右侧栏推荐相关开源项目，并给出一句话中文简介。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosleep00/dsh-github-radar.git"
  },
  "homepage": "https://github.com/nosleep00/dsh-github-radar#readme",
  "bugs": {
    "url": "https://github.com/nosleep00/dsh-github-radar/issues"
  },
  "main": "./dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./client/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "screenshots.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1,
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "github",
    "trending",
    "recommendation",
    "radar",
    "sidebar",
    "marketplace"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "dsh-github-radar contributors"
  },
  "icon": "icon.svg"
}
